{% extends "base.html" %}

{% block content %}
<div class="container">
    <h2>Pay for Order #{{ order.id }}</h2>

    <p>Total amount: <strong>₹{{ "%.2f"|format(amount) }}</strong></p>

    <button type="button" id="showQr">Show UPI QR Code</button>

    <div id="qrSection" style="display:none; margin-top:20px;">
        <img
            src="data:image/png;base64,{{ qr_base64 }}"
            alt="UPI payment QR code"
            width="280"
        >
        <p>Scan with Google Pay, PhonePe, Paytm, or another UPI app.</p>
        <p><strong>Note:</strong> Payment is not confirmed automatically.</p>
    </div>
</div>

<script>
document.getElementById("showQr").addEventListener("click", function () {
    document.getElementById("qrSection").style.display = "block";
    this.style.display = "none";
});
</script>
{% endblock %}